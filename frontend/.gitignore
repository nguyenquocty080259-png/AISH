# =========================================================
# AISH Frontend — .gitignore
# Stack: React, Vite, Node
# =========================================================

# === Dependencies ===
node_modules/
jspm_packages/
bower_components/
web_modules/

# === Build output ===
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# === Environment ===
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Cache ===
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# === Testing & coverage ===
coverage/
*.lcov
.nyc_output/

# === IDE (JetBrains) ===
.idea/

# === IDE (VSCode) ===
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# === OS files (macOS) ===
.DS_Store
.AppleDouble
.LSOverride
._*

# === OS files (Windows) ===
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
