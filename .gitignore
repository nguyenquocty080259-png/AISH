# =========================================================
# AISH — Root .gitignore
# Monorepo: backend (Java/Spring Boot/Maven) + frontend (React/Vite)
# Mỗi module có thêm .gitignore riêng (backend/.gitignore, frontend/.gitignore)
# =========================================================

# === Dependencies ===
node_modules/
jspm_packages/
bower_components/

# === Build output ===
target/
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# === Environment / secrets ===
.env
.env.local
.env.*.local
*.pem
backend/src/main/resources/application.properties

# === Runtime uploads ===
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploadsv/

# === Logs ===
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Cache ===
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache

# === Testing & coverage ===
coverage/
*.lcov
.nyc_output/

# === IDE ===
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# === OS files ===
.DS_Store
.DS_*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# === Java / Maven (fallback nếu chạy Maven ở ngoài backend/) ===
*.class
*.jar
*.war
hs_err_pid*
replay_pid*

# === Database dumps & local DB data ===
# Chỉ chặn dump/backup thật, KHÔNG chặn theo đuôi tài liệu (pdf/docx/txt...)
*.sql
*.dump
*.sqlite
*.sqlite3
/docker/db_data/
mysql_data/
postgres_data/

# === Backup / temp files ===
**/*.backup.*
**/*.back.*
*.tmp
*.temp

# === Claude Code (local, do not track) ===
.claude/
