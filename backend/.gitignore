# =========================================================
# AISH Backend — .gitignore
# Stack: Java, Spring Boot, Maven, IntelliJ
# =========================================================

# === Build output ===
target/
out/
*.class
*.jar
*.war
*.nar
*.ear

# === Maven ===
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# === Crash / dump logs ===
hs_err_pid*
replay_pid*
*.ctxt
.mtj.tmp/

# === IDE (IntelliJ) ===
.idea/
.idea_modules/
*.iml
*.iws
*.ipr

# === Eclipse (m2e) ===
.project
.classpath

# === OS files ===
.DS_Store
Thumbs.db

# === Logs ===
*.log
logs/

# === Database dumps / local DB data ===
# Chặn dump/backup DB thật, KHÔNG chặn theo đuôi tài liệu (pdf/docx/txt...)
# vì backend/uploads/ chứa bộ seed data (PDF/DOCX/PPTX/TXT) cần được commit
# cho DbSeedRunner — xem seed-manifest.json.
*.sql
*.dump
*.db
*.sqlite
*.sqlite3
